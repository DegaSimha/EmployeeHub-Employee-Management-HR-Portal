{
  "info": {
    "name": "EmployeeHub API",
    "description": "Local EmployeeHub API examples. Run Login first to populate the token variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "employeeId", "value": "1" },
    { "key": "departmentId", "value": "1" },
    { "key": "leaveId", "value": "1" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@employeehub.com\",\"password\":\"Admin@123\"}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Signed in', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', pm.response.json().token);"] } }]
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        { "name": "List employees", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/employees?page=0&size=10" } },
        { "name": "Search employees", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/employees/search?keyword=rahul" } },
        { "name": "Get employee", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/employees/{{employeeId}}" } },
        { "name": "Create employee", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"firstName\":\"Taylor\",\"lastName\":\"Morgan\",\"email\":\"taylor.morgan@example.com\",\"phone\":\"+1-555-0144\",\"departmentId\":{{departmentId}},\"designation\":\"People Partner\",\"salary\":72000,\"joiningDate\":\"2026-01-15\",\"employmentType\":\"FULL_TIME\",\"status\":\"ACTIVE\",\"initialPassword\":\"ChangeMe123\"}" }, "url": "{{baseUrl}}/api/employees" } },
        { "name": "Update employee", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"firstName\":\"Rahul\",\"lastName\":\"Kumar\",\"email\":\"rahul.kumar@employeehub.com\",\"phone\":\"+1-555-0101\",\"departmentId\":{{departmentId}},\"designation\":\"Senior Software Engineer\",\"salary\":85000,\"joiningDate\":\"2024-01-15\",\"employmentType\":\"FULL_TIME\",\"status\":\"ACTIVE\"}" }, "url": "{{baseUrl}}/api/employees/{{employeeId}}" } },
        { "name": "Delete employee", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/employees/{{employeeId}}" } }
      ]
    },
    {
      "name": "Departments",
      "item": [
        { "name": "List departments", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/departments" } },
        { "name": "Create department", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Customer Success\",\"description\":\"Customer onboarding and success\",\"managerName\":\"Jordan Lee\",\"active\":true}" }, "url": "{{baseUrl}}/api/departments" } },
        { "name": "Get department", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/departments/{{departmentId}}" } },
        { "name": "Update department", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Engineering\",\"description\":\"Product engineering and technology\",\"managerName\":\"Arjun Reddy\",\"active\":true}" }, "url": "{{baseUrl}}/api/departments/{{departmentId}}" } },
        { "name": "Delete department", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/departments/{{departmentId}}" } }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        { "name": "List attendance", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/attendance" } },
        { "name": "Get attendance", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/attendance/1" } },
        { "name": "Attendance by employee", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/attendance/employee/{{employeeId}}" } },
        { "name": "My attendance (employee token required)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/attendance/mine" } },
        { "name": "Check in (employee token required)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/attendance/mine/check-in" } },
        { "name": "Check out (employee token required)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/attendance/mine/check-out" } },
        { "name": "Create attendance", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"employeeId\":{{employeeId}},\"attendanceDate\":\"2026-10-06\",\"checkIn\":\"09:00:00\",\"checkOut\":\"17:30:00\",\"status\":\"PRESENT\"}" }, "url": "{{baseUrl}}/api/attendance" } },
        { "name": "Update attendance", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"employeeId\":{{employeeId}},\"attendanceDate\":\"2026-10-06\",\"checkIn\":\"09:15:00\",\"checkOut\":\"17:30:00\",\"status\":\"LATE\"}" }, "url": "{{baseUrl}}/api/attendance/1" } }
      ]
    },
    {
      "name": "Leave",
      "item": [
        { "name": "List leave requests", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/leaves" } },
        { "name": "Apply for leave (employee token required)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"leaveType\":\"ANNUAL\",\"startDate\":\"2026-11-12\",\"endDate\":\"2026-11-14\",\"reason\":\"Planned time away\"}" }, "url": "{{baseUrl}}/api/leaves" } },
        { "name": "My leave requests (employee token required)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/leaves/mine" } },
        { "name": "Withdraw my pending leave (employee token required)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/leaves/mine/{{leaveId}}" } },
        { "name": "Approve leave", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/leaves/{{leaveId}}/approve" } },
        { "name": "Reject leave", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"comment\":\"Please coordinate alternate coverage.\"}" }, "url": "{{baseUrl}}/api/leaves/{{leaveId}}/reject" } }
      ]
    },
    {
      "name": "Company calendar",
      "item": [
        { "name": "List holidays", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/holidays" } },
        { "name": "Create holiday", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Founders Day\",\"holidayDate\":\"2026-10-20\",\"description\":\"Company celebration\",\"paid\":true}" }, "url": "{{baseUrl}}/api/holidays" } },
        { "name": "Get holiday", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/holidays/1" } },
        { "name": "Update holiday", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Founders Day\",\"holidayDate\":\"2026-10-21\",\"description\":\"Company celebration\",\"paid\":true}" }, "url": "{{baseUrl}}/api/holidays/1" } },
        { "name": "Delete holiday", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/holidays/1" } }
      ]
    },
    {
      "name": "Dashboard, profile and reports",
      "item": [
        { "name": "Dashboard statistics", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/dashboard/statistics" } },
        { "name": "Recent employees", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/dashboard/recent-employees" } },
        { "name": "Recent leaves", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/dashboard/recent-leaves" } },
        { "name": "Profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/profile" } },
        { "name": "Update profile", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"phone\":\"+1-555-0120\",\"address\":\"150 Market Street\",\"city\":\"San Francisco\",\"state\":\"California\",\"country\":\"United States\"}" }, "url": "{{baseUrl}}/api/profile" } },
        { "name": "Change my password", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"currentPassword\":\"Employee@123\",\"newPassword\":\"NewEmployeeSecret123\"}" }, "url": "{{baseUrl}}/api/profile/password" } },
        { "name": "Employee report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/reports/employees" } },
        { "name": "Department report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/reports/departments" } },
        { "name": "Attendance report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/reports/attendance" } },
        { "name": "Leave report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/reports/leaves" } }
      ]
    }
  ]
}
